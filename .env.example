# Address of vangogh, without a trailing slash
VANGOGH_URL=http://vangogh.lan:1853
# The vangogh account of role "user" meant for a frontend.
# A password with a $ in it: write each $ as $$ here.
VANGOGH_USERNAME=
VANGOGH_PASSWORD=
# Time of the daily rebuild, HH:MM, and its time zone. Put it after vangogh's own sync.
REBUILD_AT=04:30
TZ=UTC
# Path inside the container to a logo that replaces the built-in one
CUSTOM_LOGO=
# Folder on the host that holds the custom logo, mounted at /logo.
# Without it, /logo is the empty volume canvas-logo.
# LOGO_DIR=/srv/canvas/logo
# Seconds to wait for open connections when the container is stopped
SHUTDOWN_TIMEOUT=5
# Port on the host
CANVAS_PORT=1854
